{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["units", "devices"],
  "properties": {
    "units": {"const": "mm"},
    "devices": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "step", "mount_hole_diameter", "mounts"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "step": {"type": "string", "minLength": 1},
          "mount_hole_diameter": {"type": "number", "minimum": 1},
          "mounts": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
          },
          "rotation_deg": {"type": "number"},
          "keepouts": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "min", "max"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "min": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
                "max": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
              }
            }
          }
        }
      }
    }
  }
}
